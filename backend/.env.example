# Copy to .env and adjust. Never commit the real .env file.

# --- server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# --- model ----------------------------------------------------------------
# deepgaze2e | deepgaze3 | deepgaze1
MODEL_NAME=deepgaze2e
# auto | cpu | cuda
DEVICE=auto
# Longest side (px) of a single inference pass.
MAX_INFERENCE_SIDE=1024
# tile | downscale  (tile = split long pages into overlapping tiles)
LONG_PAGE_STRATEGY=tile
TILE_HEIGHT=640
TILE_WIDTH=1024
TILE_OVERLAP=96
# Longest side (px) of the coarse whole-page pass that supplies the global
# attention profile. The model normalises every tile it sees to sum to one,
# so the tiles alone cannot tell which part of a page attracts attention.
# Set to 0 to disable the coarse pass.
COARSE_INFERENCE_SIDE=1024
# uniform | vertical | mit1003
# uniform is the right default for web pages (see docs/architecture.md).
CENTER_BIAS=uniform
USE_CENTER_BIAS=false
# Where the downloaded centre-bias prior is cached.
MODEL_WEIGHTS_DIR=./weights

# --- outputs --------------------------------------------------------------
DEFAULT_COLORMAP=jet
DEFAULT_BLUR_SIGMA=0
DEFAULT_OPACITY=0.55
DEFAULT_TOP_N=5
FOLD_HEIGHT=800

# --- security -------------------------------------------------------------
# Leave empty for local development. Set a long random value in production.
API_TOKEN=
MAX_UPLOAD_BYTES=26214400
MAX_IMAGE_PIXELS=60000000
RATE_LIMIT_PER_MINUTE=30
# Allowed origins, comma separated. These are regular expressions, because
# the CORS layer matches origins literally — a plain "*" wildcard does not work.
# The defaults below accept any Chrome or Firefox extension origin.
CORS_ORIGINS=chrome-extension://[a-p]{32},moz-extension://[0-9a-f\-]{36},http://127.0.0.1:8001,http://localhost:8001

# --- misc -----------------------------------------------------------------
ANALYSIS_CACHE_SIZE=8
