# Copy to .env next to docker-compose.yml and adjust. Never commit it.
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml up --build
#
# The compose file reads this file automatically when it sits next to it.

# --- server ---------------------------------------------------------------
# The container always binds 0.0.0.0 inside; the port is published on the
# host by the compose file.
PORT=8001
LOG_LEVEL=INFO

# --- model ----------------------------------------------------------------
# deepgaze2e | deepgaze3 | deepgaze1
MODEL_NAME=deepgaze2e
# auto | cpu | cuda — the CPU image has no GPU, so use cpu or auto there.
DEVICE=auto
LONG_PAGE_STRATEGY=tile
CENTER_BIAS=uniform

# --- security -------------------------------------------------------------
# Leave empty for a local server. In production set a long random value and
# put the same value in the extension's settings.
#
#   openssl rand -hex 32
API_TOKEN=

# The origins that may call the API. These are regular expressions, because
# the CORS layer matches origins literally.
CORS_ORIGINS=chrome-extension://[a-p]{32},moz-extension://[0-9a-f\-]{36},http://127.0.0.1:8001,http://localhost:8001

# --- limits ---------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_BYTES=26214400

# --- performance ----------------------------------------------------------
# The number of threads the model uses on the CPU. Set it to the number of
# cores the container may use.
OMP_NUM_THREADS=4

# --- HTTPS (only for the tls stack) ---------------------------------------
# The domain that points at this host. The proxy obtains the certificate for
# it on its own.
LOOKATIFY_DOMAIN=
# The address the certificate's expiry notices go to.
ACME_EMAIL=admin@example.com
